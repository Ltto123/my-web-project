# ============================================
# 博客系统环境变量模板
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ============================================

# 博主用户名（必填）
BLOG_OWNER_USERNAME=Ltto123

# JWT 签名密钥（必填，每个部署独立生成；不要使用示例值）
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# 可选 SQLite 地址；本地默认根目录 blog.db，Docker Compose 使用 data/blog.db。
# DATABASE_URL=sqlite:///./blog.db

# DeepSeek API（词汇模块的 AI 解析功能需要）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
