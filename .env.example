# 博主用户名（必填）
BLOG_OWNER_USERNAME=Ltto123

# DeepSeek API（词汇模块的 AI 解析功能需要）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
